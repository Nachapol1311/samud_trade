# --- ฐานข้อมูล MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=samud_trade

# --- Web service ---
PORT=3000
# ข้อความสุ่มอะไรก็ได้ ใช้เซ็นชื่อ cookie ของการ login
COOKIE_SECRET=change-me-to-any-random-text
# origin ของ front-end ที่อนุญาตให้เรียก web service (คั่นด้วย ,)
FRONTEND_ORIGIN=http://localhost:3030,http://127.0.0.1:3030